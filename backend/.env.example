# ─── RadFast ACS — Backend Configuration ─────────────────────────────────────
# ⚠️  JANGAN COMMIT FILE INI KE GIT
#     Pastikan file `.env` ada di `.gitignore`

# ── Server ──────────────────────────────────────────────────────────────────
PORT=9000
NODE_ENV=development

# ── Trusted origins (CSV) ───────────────────────────────────────────────────
# Tambahkan domain produksi di sini, dipisah koma. Wildcard tidak didukung.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9000

# ── Auth ────────────────────────────────────────────────────────────────────
# JWT_SECRET wajib minimal 64 karakter. Generate baru dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ada7c48f8327576b1a82e59007ae56299dc8bd66846ddb6284cf054710da5b003fd555b743e7afb0223a9cd3e770d38b
JWT_EXPIRES_IN=8h
JWT_ISSUER=radfast-admin
JWT_AUDIENCE=radfast-admin-ui

# Password admin disimpan sebagai bcrypt hash (cost factor 12).
# Untuk mengubah password: jalankan `node scripts/set-admin-password.js`
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$e4KeWbDBlHom5HwjFmiQeeL8eggZfZxqQdsTrcGnhXZRFX4dtjH7G

# Optional 2FA (TOTP) — kosongkan untuk disable
ADMIN_TOTP_SECRET=

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_API_MAX=240
RATE_LIMIT_API_WINDOW_MIN=15

# ── Lockout setelah gagal login berturut-turut ──────────────────────────────
LOGIN_LOCKOUT_THRESHOLD=8
LOGIN_LOCKOUT_DURATION_MIN=30

# ── Trust proxy (set ke 1 jika di belakang nginx/cloudflare) ────────────────
TRUST_PROXY=0

# ── Logging ─────────────────────────────────────────────────────────────────
AUDIT_LOG_DIR=./data/logs

# ─── Default credentials untuk first-time setup ─────────────────────────────
# Username : admin
# Password : RadFast@eb14acd61a88
# WAJIB DIGANTI segera setelah login pertama via halaman profile.
